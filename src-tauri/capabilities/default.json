{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AniDesk 主窗口与提醒窗口所需权限",
  "windows": ["main", "reminder"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.bgm.tv/**" },
        { "url": "https://graphql.anilist.co/**" },
        { "url": "https://*.bgm.tv/**" }
      ]
    },
    "notification:default",
    "opener:default",
    "autostart:default"
  ]
}
